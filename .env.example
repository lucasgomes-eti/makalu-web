# Base URL of the Makalu REST API. Required — the app throws on boot without it.
NEXT_PUBLIC_API_BASE_URL=https://api-makalu-development.up.railway.app

# Browser-side Google Maps key, used by the store location picker.
# Optional: without it the picker renders a message instead of a map.
# This value ships to the browser — restrict it by HTTP referrer in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
